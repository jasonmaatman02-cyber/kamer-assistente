# Copy this file to .env and fill in your own values.
# .env is git-ignored and is the ONLY place secrets should live.

# --- OpenAI (optional fallback only; free stack is default) ---
OPENAI_API_KEY=

# --- TP-Link Tapo smart lamps ---
TAPO_USER=you@example.com
TAPO_PASSWORD=

# --- Gmail (log mailer) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
RECEIVER=

# --- Apple iCloud calendar (CalDAV app-specific passwords) ---
# Account 1 is altijd iCloud. De provider van account 2 staat in Settings
# (agenda.account2_provider) -- APPLE_ID_2 blijft gewoon "het e-mailadres
# van account 2", ook als die provider "google" is (zie hieronder).
APPLE_ID_1=
APPLE_PASSWORD_1=
APPLE_ID_2=
APPLE_PASSWORD_2=

# --- Google Agenda (OAuth 2.0 -- alleen nodig als agenda.account2_provider
# op "google" staat). Maak een OAuth-client aan op console.cloud.google.com
# (type "Webtoepassing", met GOOGLE_REDIRECT_URI als toegestane redirect-URI)
# en koppel daarna eenmalig via Settings -> Google Agenda -> Verbind. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/callback

# --- Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# --- Optional weather / search keys (free providers are the default) ---
OPENWEATHER_KEY=
WEATHERAPI_KEY=
SERPER_API_KEY=

# --- Optional wake word (Porcupine). Free AccessKey: https://console.picovoice.ai/
# Also drop a Dutch "hey kamer" .ppn at voice/hey_kamer.ppn ---
PICOVOICE_ACCESS_KEY=
