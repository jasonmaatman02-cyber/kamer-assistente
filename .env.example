# Copy this file to .env and fill in your own values.
# .env is git-ignored and is the ONLY place secrets should live.

# --- OpenAI (optional fallback only; free stack is default) ---
OPENAI_API_KEY=

# --- TP-Link Tapo smart lamps ---
TAPO_USER=you@example.com
TAPO_PASSWORD=

# --- Gmail (log mailer) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
RECEIVER=

# --- Apple iCloud calendar (CalDAV app-specific passwords) ---
APPLE_ID_1=
APPLE_PASSWORD_1=
APPLE_ID_2=
APPLE_PASSWORD_2=

# --- Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# --- Optional weather / search keys (free providers are the default) ---
OPENWEATHER_KEY=
WEATHERAPI_KEY=
SERPER_API_KEY=
