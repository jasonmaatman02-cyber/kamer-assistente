[Unit]
Description=Kamer-assistent webdashboard
# Netwerk nodig voor Spotify/weer; Ollama is optioneel (dashboard start ook zonder)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/kamer-assistente
ExecStart=/home/pi/kamer-assistente/.venv/bin/python -m rundashboard
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
# Herstart ook als het dashboard draait maar niet meer antwoordt (dead-lock / alle workers vast):
# Dashboard/backend/watchdog.py meldt elke 60s "gezond" zolang /api/config antwoordt. Ruim gekozen
# zodat een even zwaar belaste Pi (Ollama) geen valse herstart krijgt.
WatchdogSec=180
NotifyAccess=main
# Geef 't wat lucht op een Pi 4B, maar niet oneindig
MemoryMax=1200M
Nice=5

[Install]
WantedBy=multi-user.target
